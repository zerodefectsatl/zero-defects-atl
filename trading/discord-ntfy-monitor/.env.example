# Discord bot token — from https://discord.com/developers/applications
# (Bot tab -> Reset Token). NEVER commit the real .env file.
DISCORD_BOT_TOKEN=

# Your ntfy topic — same one you subscribed to in the ntfy phone app.
# Use an unguessable name, e.g. zd-trades-k93hx2
NTFY_TOPIC=

# Optional: self-hosted ntfy server (defaults to https://ntfy.sh)
# NTFY_SERVER=https://ntfy.sh

# Optional: ntfy access token if your topic requires auth
# NTFY_TOKEN=
